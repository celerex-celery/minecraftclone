{
  "name": "minecraft-voxel",
  "version": "1.10",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "description": "A Minecraft-style voxel survival game built with three.js and the real Minecraft asset pack.",
  "productName": "Minecraft Voxel",
  "author": "celerex",
  "scripts": {
    "start": "node tools/serve.js 3066",
    "electron": "electron .",
    "dev": "concurrently \"npm start\" \"npm run electron\"",
    "build": "electron-builder --win",
    "test": "node tools/smoke-test.mjs",
    "test:save": "node tools/save-test.mjs",
    "test:portal": "node tools/portal-test.mjs",
    "test:nether": "node tools/nether-test.mjs",
    "icon": "node tools/make-favicon.mjs"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "^31.0.0",
    "electron-builder": "^25.0.0"
  },
  "dependencies": {
    "fs-extra": "^11.2.0"
  },
  "build": {
    "appId": "com.yourname.minecraftvoxel",
    "productName": "Minecraft Voxel",
    "executableName": "Minecraft Voxel",
    "directories": {
      "output": "installer"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!node_modules/**/{CHANGELOG.md,README.md,LICENSE}"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
